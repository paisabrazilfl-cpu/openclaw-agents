# ============================================================
# OpenClaw Console — environment configuration
# ============================================================
# Two ways to provide keys:
#   1. Copy this file to `.env.local` and fill it in (good for deploys), OR
#   2. Add them in the in-app Settings page (⚙️ → /settings) — stored in a
#      git-ignored keystore and applied immediately, no restart needed.
# Both are git-ignored and must NEVER be committed.
#
#   cp .env.example .env.local
#
# Only what you fill in gets enabled — the UI greys out the rest.
# At minimum, set ONE LLM provider key (OpenRouter recommended).
# ============================================================

# ── LLM providers (need at least one) ───────────────────────
# OpenRouter is the recommended universal gateway (many models, one key).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Default model id used when the picker hasn't loaded yet.
DEFAULT_MODEL=openai/gpt-4o-mini
# Max output tokens per reply (keep modest to control cost/credit use).
MAX_TOKENS=2048

# ── Observability (optional) ────────────────────────────────
# If set, OpenRouter/OpenAI traffic is routed through Helicone.
HELICONE_API_KEY=
LANGCHAIN_API_KEY=

# ── Embeddings + Vector memory (Pinecone) ───────────────────
# Falls back to OPENAI_API_KEY for embeddings if this is empty.
OPENAI_EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
PINECONE_API_KEY=
# The index's DATA-PLANE host, found in the Pinecone console, e.g.
# my-index-abc123.svc.aped-4627-b74a.pinecone.io
# Create the index with dimension 1536 (text-embedding-3-small).
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=openclaw

# ── Web search (set any one) ────────────────────────────────
TAVILY_API_KEY=
EXA_API_KEY=
SERPAPI_API_KEY=

# ── Web crawl / scrape (FreeCrawl, Firecrawl-compatible) ────
FREECRAWL_API_KEY=
FREECRAWL_BASE_URL=https://api.freecrawl.dev

# ── Code execution (E2B) ────────────────────────────────────
E2B_API_KEY=

# ── Misc / reserved for future wiring ───────────────────────
COMPOSIO_API_KEY=
MASSIVE_API_KEY=
INNGEST_EVENT_KEY=
GITHUB_TOKEN=

# Shown as the app title (and X-Title to OpenRouter).
APP_NAME=OpenClaw Console
